# Core (required in production)
APP_NAME=Doorush
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# Local PostgreSQL only. Create this database/user before starting the API.
DATABASE_URL=postgresql+asyncpg://swiftdrop:swiftdrop@localhost:5432/swiftdrop

# CORS: comma-separated origins. Required for cookie auth from admin/merchant web apps.
# In production, do NOT use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Auth/session (required in production)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=43200
SESSION_COOKIE_NAME=swiftdrop_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Setup/maintenance endpoints (keep disabled in production)
ALLOW_SETUP_ENDPOINTS=false
SETUP_SECRET=

# Public signup policy
ALLOW_PUBLIC_MERCHANT_SIGNUP=true

# External integrations are intentionally disabled for local testing.
# Leave these blank; empty credentials prevent outbound provider calls.
# Payments (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=

# SMS (Twilio) - optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Admin SDK - optional
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Maps proxy (leave blank locally unless you explicitly want live map calls)
TOMTOM_API_KEY=

# Optional
REDIS_URL=
